{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(cargo:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(cmake:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(rustfmt:*)",
      "Bash(gofmt:*)",
      "Bash(clang-format:*)",
      "Bash(prettier:*)",
      "Bash(eslint:*)",
      "Bash(pytest:*)",
      "Bash(vitest:*)",
      "Bash(jest:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "Bash(claude:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(openocd:*)",
      "Bash(st-flash:*)",
      "Bash(arm-none-eabi-gcc:*)",
      "Bash(arm-none-eabi-gdb:*)",
      "Bash(tmux:*)",
      "Bash(knip:*)",
      "Bash(depcheck:*)",
      "Bash(ts-prune:*)",
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "mcp__context7",
      "mcp__tavily",
      "mcp__github"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777 /*)",
      "Bash(> /dev/sda*)",
      "Bash(mkfs:*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force:*)",
      "Bash(shred:*)",
      "Bash(truncate -s 0:*)",
      "Bash(crontab -r)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/service-account*.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/pre-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/post-format.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "model": "claude-fable-5[1m]"
}
